# Template only. Real values belong in the WSL SOPS vault, not in the repository.
PRODUCT_DB_PASSWORD=REPLACE_ME_DEV_PRODUCT
ORDER_DB_PASSWORD=REPLACE_ME_DEV_ORDER
INVENTORY_DB_PASSWORD=REPLACE_ME_DEV_INVENTORY
PAYMENT_DB_PASSWORD=REPLACE_ME_DEV_PAYMENT
PAYMENT_PROVIDER=simulation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_BASE_URL=http://127.0.0.1:18070/index.html
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_SIGNATURE_TOLERANCE_SECONDS=300
NOTIFICATION_DB_PASSWORD=REPLACE_ME_DEV_NOTIFICATION
CUSTOMER_DB_PASSWORD=REPLACE_ME_DEV_CUSTOMER
DELIVERY_DB_PASSWORD=REPLACE_ME_DEV_DELIVERY
PROMOTION_DB_PASSWORD=REPLACE_ME_DEV_PROMOTION
WISHLIST_DB_PASSWORD=REPLACE_ME_DEV_WISHLIST
REVIEW_DB_PASSWORD=REPLACE_ME_DEV_REVIEW
RECOMMENDATION_DB_PASSWORD=REPLACE_ME_DEV_RECOMMENDATION
CHAT_DB_PASSWORD=REPLACE_ME_DEV_CHAT
RETURNS_DB_PASSWORD=REPLACE_ME_DEV_RETURNS
BILLING_DB_PASSWORD=REPLACE_ME_DEV_BILLING
CUSTOMER_JWT_SECRET=REPLACE_ME_WITH_BASE64_SECRET_48_BYTES
# Optional after running: bash scripts/control-center/control-center.sh jwt-rotate dev
CUSTOMER_JWT_ACTIVE_KID=
CUSTOMER_JWT_PRIVATE_KEY_BASE64=
CUSTOMER_JWT_PUBLIC_KEYS_JSON=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_DEV_GRAFANA
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@minitech.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
CHAT_SUPPORT_EMAIL=company@minitech.local
# Document cache/export budgets (per process; byte budget covers invoices and corrections).
BILLING_PDF_CACHE_MAX_BYTES=33554432
BILLING_PDF_CACHE_MAX_ENTRIES=512
BILLING_PDF_CACHE_TTL=PT15M
BILLING_EXPORT_PAGE_SIZE=25
BILLING_EXPORT_MAX_DOCUMENTS=10000
BILLING_EXPORT_MAX_CONCURRENT=2
BILLING_EXPORT_MAX_DURATION=PT5M
GATEWAY_EXPORT_MAX_CONCURRENT=2
GATEWAY_EXPORT_CONNECT_TIMEOUT_MS=1000
GATEWAY_EXPORT_READ_TIMEOUT_MS=30000
# A31 HTTP budgets and processing leases (milliseconds).
RESILIENCE_HTTP_CONNECT_TIMEOUT_MS=1000
RESILIENCE_HTTP_READ_TIMEOUT_MS=3000
RESILIENCE_HTTP_REQUEST_BUDGET_MS=15000
GATEWAY_HTTP_READ_TIMEOUT_MS=15000
ORDER_SAGA_PROCESSING_LEASE_MS=120000
ORDER_SAGA_RECOVERY_ENABLED=true
# A14: Order coordinates expiry with Payment; time alone never frees a coupon.
COUPON_RESERVATION_TTL_SECONDS=2400
COUPON_EXPIRY_ENABLED=true
COUPON_EXPIRY_DELAY_MS=5000
PAYMENT_PROCESSING_LEASE_MS=120000
NOTIFICATION_PROCESSING_LEASE_MS=120000
NOTIFICATION_SMTP_CONNECT_TIMEOUT_MS=1000
NOTIFICATION_SMTP_READ_TIMEOUT_MS=1000
NOTIFICATION_SMTP_WRITE_TIMEOUT_MS=1000

# A32 event recovery and retention (consumer names are prefixes; each JVM adds a UUID).
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_LEASE_MS=30000
OUTBOX_PUBLISHER_FIXED_DELAY_MS=5000
EVENT_CONSUMER_CLAIM_IDLE_MS=60000
PAYMENT_STREAM_RETENTION_AGE_MS=604800000
PAYMENT_STREAM_REQUIRED_GROUPS=notification-service,billing-service
EVENT_REDIS_CONNECT_TIMEOUT=1000ms
EVENT_REDIS_TIMEOUT=1000ms

# A43.37: public verification configuration only; private journal keys stay outside apps/backups.
PRIVACY_RESTORE_JOURNAL_PUBLIC_KEY_BASE64=
PRIVACY_RESTORE_JOURNAL_LEDGER_ID=
# Backup expiry stays preview-only until the A43.40 retention decision.
MINI_ORDER_PLATFORM_BACKUP_RETENTION_MODE=observe
