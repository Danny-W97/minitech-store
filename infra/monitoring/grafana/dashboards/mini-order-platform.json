{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Dostępność serwisów",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"mini-order-platform\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Żądania HTTP / s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"mini-order-platform\"}[5m])) by (application)", "legendFormat": "{{application}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Błędy HTTP 5xx / s",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"mini-order-platform\",status=~\"5..\"}[5m])) by (application)", "legendFormat": "{{application}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Notification retry i DLQ",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "notification_retry_pending{job=\"mini-order-platform\"}", "legendFormat": "retry pending", "refId": "A"},
        {"expr": "notification_dlq_open{job=\"mini-order-platform\"}", "legendFormat": "DLQ open", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Pamięć JVM",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{job=\"mini-order-platform\"}) by (application, area)", "legendFormat": "{{application}} / {{area}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["mini-order-platform", "micrometer", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Mini Order Platform",
  "uid": "mini-order-platform",
  "version": 1
}
