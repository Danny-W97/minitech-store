# Preparation only. This file is not loaded automatically and contains no secret.
SPRING_PROFILES_ACTIVE=prod,prod-vault
VAULT_ADDR=https://vault.example.internal:8200
VAULT_AUTH_METHOD=APPROLE
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KV_BACKEND=secret
VAULT_KV_PROFILE=prod
VAULT_NAMESPACE=
VAULT_TLS_SKIP_VERIFY=false

# Service endpoints and database bindings are templates only. Real passwords
# belong in OpenBao, not in this file.
PROMOTION_SERVICE_URL=https://promotion-service.minitech.internal
PROMOTION_DB_URL=jdbc:postgresql://promotion-postgres:5432/promotion_db
PROMOTION_DB_USERNAME=promotion_app
PROMOTION_DB_PASSWORD=OPENBAO_SECRET_PROMOTION_DB_PASSWORD
WISHLIST_SERVICE_URL=https://wishlist-service.minitech.internal
WISHLIST_DB_URL=jdbc:postgresql://wishlist-postgres:5432/wishlist_db
WISHLIST_DB_USERNAME=wishlist_app
WISHLIST_DB_PASSWORD=OPENBAO_SECRET_WISHLIST_DB_PASSWORD
REVIEW_SERVICE_URL=https://review-service.minitech.internal
REVIEW_DB_URL=jdbc:postgresql://review-postgres:5432/review_db
REVIEW_DB_USERNAME=review_app
REVIEW_DB_PASSWORD=OPENBAO_SECRET_REVIEW_DB_PASSWORD
RECOMMENDATION_SERVICE_URL=https://recommendation-service.minitech.internal
RECOMMENDATION_DB_URL=jdbc:postgresql://recommendation-postgres:5432/recommendation_db
RECOMMENDATION_DB_USERNAME=recommendation_app
RECOMMENDATION_DB_PASSWORD=OPENBAO_SECRET_RECOMMENDATION_DB_PASSWORD
CHAT_SERVICE_URL=https://chat-service.minitech.internal
CHAT_DB_URL=jdbc:postgresql://chat-postgres:5432/chat_db
CHAT_DB_USERNAME=chat_app
CHAT_DB_PASSWORD=OPENBAO_SECRET_CHAT_DB_PASSWORD
CHAT_SUPPORT_EMAIL=support@minitech.example
