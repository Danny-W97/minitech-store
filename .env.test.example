ORDER_DB_PASSWORD=REPLACE_ME_TEST_ORDER
INVENTORY_DB_PASSWORD=REPLACE_ME_TEST_INVENTORY
PAYMENT_DB_PASSWORD=REPLACE_ME_TEST_PAYMENT
PAYMENT_PROVIDER=simulation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_BASE_URL=http://127.0.0.1:18070/index.html
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_SIGNATURE_TOLERANCE_SECONDS=300
NOTIFICATION_DB_PASSWORD=REPLACE_ME_TEST_NOTIFICATION
CUSTOMER_DB_PASSWORD=REPLACE_ME_TEST_CUSTOMER
DELIVERY_DB_PASSWORD=REPLACE_ME_TEST_DELIVERY
PROMOTION_DB_PASSWORD=REPLACE_ME_TEST_PROMOTION
WISHLIST_DB_PASSWORD=REPLACE_ME_TEST_WISHLIST
REVIEW_DB_PASSWORD=REPLACE_ME_TEST_REVIEW
RECOMMENDATION_DB_PASSWORD=REPLACE_ME_TEST_RECOMMENDATION
CHAT_DB_PASSWORD=REPLACE_ME_TEST_CHAT
RETURNS_DB_PASSWORD=REPLACE_ME_TEST_RETURNS
BILLING_DB_PASSWORD=REPLACE_ME_TEST_BILLING
CUSTOMER_JWT_SECRET=REPLACE_ME_WITH_BASE64_SECRET_48_BYTES
# Optional after running: bash scripts/control-center/control-center.sh jwt-rotate test
CUSTOMER_JWT_ACTIVE_KID=
CUSTOMER_JWT_PRIVATE_KEY_BASE64=
CUSTOMER_JWT_PUBLIC_KEYS_JSON=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_TEST_GRAFANA
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@minitech.test
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
CHAT_SUPPORT_EMAIL=company@minitech.test
# A14: Order coordinates expiry with Payment; time alone never frees a coupon.
COUPON_RESERVATION_TTL_SECONDS=2400
COUPON_EXPIRY_ENABLED=true
COUPON_EXPIRY_DELAY_MS=5000

# A43.37: public verification configuration only; private journal keys stay outside apps/backups.
PRIVACY_RESTORE_JOURNAL_PUBLIC_KEY_BASE64=
PRIVACY_RESTORE_JOURNAL_LEDGER_ID=
# Backup expiry stays preview-only until the A43.40 retention decision.
MINI_ORDER_PLATFORM_BACKUP_RETENTION_MODE=observe
